{
  "name": "pi-remote-server",
  "version": "0.1.0",
  "description": "LAN bridge server exposing the pi coding agent to the Pi Remote Android app",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types \"src/**/*.test.ts\"",
    "test:e2e": "node test/e2e.mjs && node test/e2e2.mjs && node test/e2e3.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.0",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
